# Server
SERVER_PORT=8080

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=scanin_db
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# JWT Security
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRATION_MS=31536000000

# Office Wi-Fi IP Settings
OFFICE_IP_IS_STATIC=true
OFFICE_IP_STATIC_VALUE=127.0.0.1
OFFICE_IP_SECRET_KEY=your_office_secret_key