# Server
SERVER_PORT=8080

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=scanin_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT Security (Minimum 32 simvol olmalıdır)
JWT_SECRET=ScanInSuperSecretKeyForJwtAuthentication2026OfficeProject!
JWT_EXPIRATION_MS=31536000000

# Office Wi-Fi IP Settings
# Lokal testdə 127.0.0.1 qalır. Ofisdə real IP-ni yazacaqsan (və ya dinamik üçün false edəcəksən)
OFFICE_IP_IS_STATIC=false
OFFICE_IP_STATIC_VALUE=127.0.0.1
OFFICE_IP_SECRET_KEY=ScanInSecret2026